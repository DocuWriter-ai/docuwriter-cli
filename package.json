{
  "name": "@docuwriter-ai/cli",
  "version": "0.1.0",
  "description": "Start DocuWriter documentation from your local project",
  "type": "module",
  "bin": {
    "docuwriter": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run --pool=forks --fileParallelism",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "archiver": "8.0.0",
    "commander": "15.0.0",
    "ignore": "7.0.12",
    "open": "11.0.4"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "^22.18.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "homepage": "https://www.docuwriter.ai",
  "author": "DocuWriter.ai",
  "license": "MIT",
  "keywords": [
    "docuwriter",
    "documentation",
    "cli",
    "markdown",
    "codebase"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocuWriter-ai/docuwriter-cli.git"
  },
  "bugs": {
    "url": "https://github.com/DocuWriter-ai/docuwriter-cli/issues"
  }
}
